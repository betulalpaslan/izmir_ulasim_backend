const express = require("express");
const axios = require("axios");
const { fetchParks, isParkAndRide, toOtpParking, toParkingStation } = require("../services/ParkingService");

const OTP_PORT = process.env.OTP_PORT || 8080;
const OTP_URL = `http://localhost:${OTP_PORT}/otp/gtfs/v1`;

const router = express.Router();

router.get("/feed", async (req, res) => {
  const all = await fetchParks();
  const vehicleParkings = all.filter(isParkAndRide).map(toOtpParking);
  res.json({ vehicleParkings });
});

router.get("/stations", async (req, res) => {
  try {
    const all = await fetchParks();
    const stations = all
      .filter(isParkAndRide)
      .filter((p) => p.lat && p.lng)
      .map(toParkingStation);
    res.json({ stations, updatedAt: new Date().toISOString() });
  } catch (err) {
    console.error("Otopark stations hatası:", err.message);
    res.status(502).json({ error: "İZELMAN otopark servisine ulaşılamıyor." });
  }
});

// OTP'nin routing için kullandığı lotlar — doluluk doğrudan İZELMAN'dan
router.get("/otp-lots", async (req, res) => {
  const query = `{
    vehicleParking {
      vehicleParkingId
      name
      lat
      lon
      tags
    }
  }`;
  try {
    const [otpRes, izelmanParks] = await Promise.all([
      axios.post(OTP_URL, { query }, { timeout: 10000 }),
      fetchParks(),
    ]);

    const lots = otpRes.data?.data?.vehicleParking || [];

    // İZELMAN canlı doluluk verisini ufid'e göre indeksle
    const izelmanMap = {};
    for (const p of izelmanParks) {
      izelmanMap[`izmir-pr:${p.ufid}`] = p;
    }

    const tagFilter = req.query.tag; // örn. ?tag=park_and_ride veya ?tag=bike_and_ride
    const filtered = tagFilter ? lots.filter((p) => (p.tags || []).includes(tagFilter)) : lots;

    const stations = filtered.map((p) => {
      const live = izelmanMap[p.vehicleParkingId];
      const free     = live?.occupancy?.total?.free     ?? null;
      const occupied = live?.occupancy?.total?.occupied ?? null;
      const capacity = free != null && occupied != null ? free + occupied : null;
      return {
        id:       p.vehicleParkingId,
        name:     p.name,
        lat:      p.lat,
        lon:      p.lon,
        tags:     p.tags || [],
        free,
        occupied,
        capacity,
      };
    });

    res.json({ stations, updatedAt: new Date().toISOString() });
  } catch (err) {
    console.error("OTP vehicleParking hatası:", err.message);
    res.status(502).json({ error: "OTP'ye ulaşılamıyor." });
  }
});

module.exports = router;
